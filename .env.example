# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase Anda
# Dashboard Supabase -> Project Settings -> API

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-public-key-anda

# -----------------------------------------------------------------------------
# Server-side only (dipakai oleh /api/*). JANGAN beri prefix VITE_ —
# variabel ber-prefix VITE_ bisa ikut ter-bundle ke JavaScript browser.
# -----------------------------------------------------------------------------

# Universal WA Bot (dipakai api/universal-bot.js)
WA_API_URL=https://alamat-bot-anda.example.com
WA_API_KEY=isi-dengan-api-key-bot

# SMTP (dipakai api/send-email.js)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=alamat@example.com
SMTP_PASS=isi-dengan-password-smtp

# Opsional: host tambahan yang boleh muncul di link_penilaian email (pisahkan koma).
# Host aplikasi yang sedang melayani request selalu diizinkan.
# APP_ALLOWED_HOSTS=babel-memilih.vercel.app,www.domain-anda.id
