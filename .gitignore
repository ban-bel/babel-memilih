# ============================================
# Sistem Penilaian Pegawai - Gitignore
# Babel Memilih @ babel-memilih.vercel.app
# ============================================

# ============================================
# Dependencies
# ============================================
node_modules/
.pnp
.pnp.js

# ============================================
# Build Output (Vite)
# ============================================
dist/
dist-ssr/
build/
out/
*.local

# ============================================
# Environment Variables & Secrets
# ⚠️ JANGAN PERNAH commit kredensial!
# ============================================
.env
.env.local
.env.*.local
*.env

# ============================================
# Database Migrations & Backups
# ============================================
*.dump
*.backup
*.bak
*.csv
*.tsv
*.xlsx
*.xls
supabase/.temp/
supabase/db_backup/
supabase/backups/
*backup*.sql
*dump*.sql

# Abaikan file SQL umum di root / luar, tapi lacak schema & migrasi di supabase/
*.sql
!supabase/*.sql
!supabase/**/*.sql
supabase/*backup*.sql
supabase/*dump*.sql

# ============================================
# WhatsApp Bot (Baileys) - LOCAL ONLY
# ⚠️ Session WA dan .env hanya di komputer lokal
# ============================================
src-bot/node_modules/
src-bot/.env
src-bot/sessions/
src-bot/*.log

# ============================================
# Editor & IDE
# ============================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Vite & Build Cache
# ============================================
.vite/
.vitest/
.eslintcache

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/

# ============================================
# OS Files
# ============================================
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.swp
*.bak
.cache/
tmp/
temp/

# ============================================
# Deployment
# ============================================
.vercel/
.netlify/

# ============================================
# AI Assistants & Local Tools
# ============================================
.claude/
.gemini/
.antigravity/
.cursor/

# ============================================
# Misc
# ============================================
*.pem
*.key
credentials.json
service-account.json
