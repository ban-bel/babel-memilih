# ============================================
# Sistem Penilaian Pegawai - Gitignore
# Babel Memilih @ babel-memilih.vercel.app
# ============================================

# ============================================
# Dependencies
# ============================================
node_modules/
.pnp
.pnp.js

# ============================================
# Build Output (Vite)
# ============================================
dist/
dist-ssr/
build/
out/
*.local

# ============================================
# Environment Variables & Secrets
# ⚠️ JANGAN PERNAH commit kredensial!
# ============================================
.env
.env.local
.env.*.local
*.env

# ============================================
# Database Migrations & Backups
# Sensitive - jangan commit!
# ============================================
*.sql
*.dump
*.backup
*.bak
*.csv
*.xlsx
*.xls
supabase/.temp/
supabase/db_backup/
supabase/migrations/*
supabase/backups/

# ============================================
# Whitelist - Schema utama (OK untuk commit)
# ============================================
!supabase/00_deploy_master.sql
!supabase/schema_struktur_semua_tabel.sql
!supabase/migrations/003_create_template_pesan_wa.sql
!supabase/migrations/006_fix_log_notifikasi_wa_rls.sql
!supabase/migrations/009_fix_log_notifikasi_wa_rls_anon.sql

# ============================================
# WhatsApp Bot (Baileys) - LOCAL ONLY
# ⚠️ Session WA dan .env hanya di komputer lokal
# ============================================
src-bot/node_modules/
src-bot/.env
src-bot/sessions/
src-bot/*.log

# ============================================
# Editor & IDE
# ============================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Vite & Build Cache
# ============================================
.vite/
.vitest/
.eslintcache

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/

# ============================================
# OS Files
# ============================================
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.swp
*.bak
.cache/
tmp/
temp/

# ============================================
# Deployment
# ============================================
.vercel/
.netlify/

# ============================================
# Claude Code
# ============================================
.claude/

# ============================================
# Misc
# ============================================
*.pem
*.key
credentials.json
service-account.json
